
@inject NavigationManager Navigation

@code {

    protected override void OnInitialized()
    {
        var relativePath =
            Navigation.ToBaseRelativePath(Navigation.Uri);

        var returnUrl =
            Uri.EscapeDataString("/" + relativePath);

        Navigation.NavigateTo(
            $"/login?returnUrl={returnUrl}",
            true);
    }
}

































