@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Identity
@using UPHC.SurveillanceDashboard.Models
@inject UserManager<ApplicationUser> UserManager

<!-- ========================= -->
<!-- 💻 DESKTOP SIDEBAR -->
<!-- ========================= -->
<div class="sidebar-container d-none d-md-flex flex-column">

    <a href="/dashboard" class="modern-nav-btn dashboard-btn">
        📊 Dashboard
    </a>

    @if (isFacilityUser)
    {
        <a href="/patiententry" class="modern-nav-btn patient-btn">
            🧾 Patient Entry
        </a>

        <a href="@facilityLink" class="modern-nav-btn records-btn">
            📁 Case Records
        </a>
    }

    @if (isAnalystGroup)
    {
        <a href="/records" class="modern-nav-btn analyst-btn">
            📂 Records
        </a>

        <a href="/uphc-list" class="modern-nav-btn uphc-btn">
            🏥 UPHC List
        </a>
    }

</div>


<!-- ========================= -->
<!-- 📱 MOBILE BOTTOM NAV -->
<!-- ========================= -->
<div class="mobile-nav d-flex d-md-none justify-content-around align-items-center">

    <a href="/dashboard" class="mobile-nav-item">
        📊
        <span>Home</span>
    </a>

    @if (isFacilityUser)
    {
        <a href="/patiententry" class="mobile-nav-item">
            🧾
            <span>Entry</span>
        </a>

        <a href="@facilityLink" class="mobile-nav-item">
            📁
            <span>Cases</span>
        </a>
    }

    @if (isAnalystGroup)
    {
        <a href="/records" class="mobile-nav-item">
            📂
            <span>Records</span>
        </a>

        <a href="/uphc-list" class="mobile-nav-item">
            🏥
            <span>UPHC</span>
        </a>
    }

</div>


@code {
    bool isAnalystGroup = false;
    bool isFacilityUser = false;

    string facilityLink = "/facility/0";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isFacilityUser =
            user.IsInRole("UPHCUser") ||
            user.IsInRole("CHCUser") ||
            user.IsInRole("UHWCUser");

        isAnalystGroup = !isFacilityUser;

        var appUser = await UserManager.GetUserAsync(user);
        if (appUser != null && appUser.FacilityId > 0)
        {
            facilityLink = $"/facility/{appUser.FacilityId}";
        }
    }
}





































